# ── AfriTech Bridge Operations — frontend environment configuration ──────────
# Copy to `frontend/.env` and adjust. Next.js loads it automatically at
# build/run time. Only `NEXT_PUBLIC_*` values are shipped to the browser.

# Backend HTTP origin used by the Next.js rewrites for /api and /uploads.
# In production build to Docker, prefer the NEXT_PUBLIC_API_URL build arg.
NEXT_PUBLIC_API_URL=http://localhost:5000