# ── AfriTech Bridge Operations — environment configuration ────────────────────
# Copy to `.env` (project root) and adjust. All values are RESTART-time.

# App
FLASK_CONFIG=development            # development | testing | production
SECRET_KEY=change-me-in-production  # session / token signing base
JWT_SECRET=change-me-too            # JWT signing (falls back to SECRET_KEY)
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=14
PORT=5000

# Database
# SQLite (default for development/testing):
DATABASE_URL=sqlite:////abs/path/to/afritech-operations/dev.db
# PostgreSQL example:
# DATABASE_URL=postgresql://afritech:afritech@localhost:5432/afritech_operations

# Business
BUSINESS_NAME=AfriTech Bridge Operations
CURRENCY=RWF
TIMEZONE=Africa/Kigali
DEFAULT_COMMISSION_RATE=0.20       # fallback when no rule/service/employee rate

# Security / rate limiting
RATE_LIMIT_DEFAULT=200 per hour;1000 per day
RATE_LIMIT_AUTH=10 per minute
PASSWORD_RESET_TOKEN_MINUTES=30

# CORS (allowed origins; '*' for dev)
CORS_ORIGINS=*

# Uploads
MAX_CONTENT_LENGTH=16777216        # 16 MB

# AfriTech LMS integration (optional)
LMS_API_URL=
LMS_API_KEY=
LMS_API_TIMEOUT=10