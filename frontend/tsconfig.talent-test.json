{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "types": ["node"],
    "noEmit": false,
    "incremental": false,
    "outDir": ".talent-test-build",
    "rootDir": "."
  },
  "include": [
    "tests/talent-passport.test.ts",
    "src/services/talent-passport.service.ts",
    "src/types/talent-passport.ts",
    "src/services/api/base.service.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
