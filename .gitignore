# Root .gitignore for Afritec Bridge LMS

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backend specific
backend/__pycache__/
backend/*.pyc
backend/venv/
backend/venv-new/
backend/instance/*.db
backend/instance/*.sqlite
backend/instance/*.sqlite3

# Node modules (frontend)
node_modules/

# Production builds
build/
dist/

# Coverage reports
coverage/
*.lcov

# Cache
.cache/
.mypy_cache/
backend/instance/*.db

# Databases — any SQLite/Postgres dump or dev DB anywhere in the repo.
# (backend/instance/afritec_lms_db.db was committed because this rule was
# missing; ignore rules do not untrack files already in the index.)
*.db
*.sqlite
*.sqlite3

# Virtualenvs anywhere (backend/venv held 10 tracked files the same way).
venv/
.venv/

# Local secrets — .env.example stays tracked, real env files never do.
backend/.env.postgresql
.env.postgresql

# Google service account keys
backend/gen-lang-client-0193686612-6ab422c5f4be.json
